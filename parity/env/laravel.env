# Target Laravel suite paritas = cermin konfigurasi PRODUKSI app2 (dicek 13 Nov 2026, lihat ../PRODUKSI.md).
# Tanpa rahasia. APP_KEY & NIK_HASH_KEY dibuat acak tiap run oleh scripts/laravel.sh; DB_DATABASE & APP_URL juga diisi skrip.
# Format: sintaks shell (di-source skrip) yang juga sah sebagai .env Laravel. Baris bertanda [lokal] sengaja
# berbeda dari produksi agar tanpa jaringan/infra luar; tidak mengubah tampilan.

APP_NAME="Contact Center"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# [lokal] produksi: pgsql
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=sigap_session
SESSION_PATH=/
SESSION_DOMAIN=null
# [lokal] produksi: true (HTTPS); target lokal memakai http
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# [lokal] produksi: reverb
BROADCAST_CONNECTION=log
# [lokal] surel tidak dikirim
MAIL_MAILER=log

VITE_APP_NAME="Contact Center"

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8124
SANCTUM_EXPIRATION=10080

# [lokal] produksi: kunci Reverb terisi (realtime); kosong = polling, halaman S1 tidak memakainya
REVERB_APP_KEY=
REVERB_APP_SECRET=
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Produksi: site key terisi → markup & CSP reCAPTCHA ikut dirender. Kunci palsu non-rahasia;
# [lokal] verifikasi diarahkan ke port tertutup dan request Google diblokir di Playwright.
RECAPTCHA_SITE_KEY=paritas-dummy-site-key
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=http://127.0.0.1:9/siteverify
RECAPTCHA_MIN_SCORE=0.5

# Produksi: AI aktif (prop bersama assistant.enabled). [lokal] driver fake, tanpa jaringan.
AI_ENABLED=true
AI_DRIVER=fake
AI_API_KEY=
AI_ASYNC=true
AI_QUEUE=ai
AI_SERVICE_DAYS=1,2,3,4,5
AI_SERVICE_START=08:00
AI_SERVICE_END=16:00
AI_SERVICE_LABEL="Senin–Jumat, 08.00–16.00 WIB"
KNOWLEDGE_ALLOWED_HOSTS=transmigrasi.go.id,peraturan.bpk.go.id,peraturan.go.id
