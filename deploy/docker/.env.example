# ============================================================================
# SIGAP — .env untuk stack Docker (deploy/docker/.env). JANGAN di-commit.
# Dibaca dua kali: oleh compose (interpolasi ${...} di compose.yml) dan oleh
# container app/queue/scheduler/reverb (env_file). Hindari karakter `$` di nilai
# rahasia (compose menganggapnya variabel) — atau tulis sebagai `$$`.
# ============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME=app2-sigap
WEB_PORT=8092                       # cloudflared → http://127.0.0.1:8092
SIGAP_TAG=latest

# --- Aplikasi ---
APP_NAME=SIGAP
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app2.andimohamad.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
# Buat: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_PREVIOUS_KEYS=
# Buat SEKALI: docker compose run --rm --no-deps app php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Simpan di brankas. JANGAN diubah tanpa `php artisan sigap:rehash-nik`.
NIK_HASH_KEY=
BCRYPT_ROUNDS=12
# IP asli dipulihkan nginx (CF-Connecting-IP); Laravel tidak memercayai header forwarding.
TRUSTED_PROXIES=127.0.0.1

# --- Log (stdout container + berkas harian di volume storage) ---
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database (container `db`) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sigap
DB_USERNAME=sigap
DB_PASSWORD=
DB_SSLMODE=disable                  # jaringan Docker internal, tidak keluar host

# --- Session / cache / queue (driver database; Redis tidak dipakai) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_COOKIE=sigap_session
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=app2.andimohamad.my.id
SANCTUM_EXPIRATION=10080

# --- Surel (SMTP kementerian) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SIGAP

# --- Reverb: sisi SERVER (PHP → container reverb, jaringan internal) ---
REVERB_APP_ID=sigap
REVERB_APP_KEY=                     # acak 32 heks: openssl rand -hex 16
REVERB_APP_SECRET=                  # acak 64 heks: openssl rand -hex 32
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=app2.andimohamad.my.id
REVERB_APP_MAX_CONNECTIONS=1000
REVERB_APP_RATE_LIMITING_ENABLED=true

# --- Reverb: sisi BROWSER (ditanam saat BUILD image; ubah → build ulang) ---
VITE_APP_NAME=SIGAP
VITE_REVERB_APP_KEY=                # SAMA dengan REVERB_APP_KEY (tulis nilainya langsung)
VITE_REVERB_HOST=app2.andimohamad.my.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- reCAPTCHA v3 (WAJIB di production) ---
# Kosong = semua pengaduan publik, survei, dan chat tamu DITOLAK (fail closed).
# Buat kunci v3 di https://www.google.com/recaptcha/admin untuk domain APP_URL.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Asisten AI contact center ---
# AI_ENABLED=false = live chat lama (langsung ke petugas).
# AI_DRIVER: fake (lokal/uji, tanpa kunci) | openai (endpoint kompatibel OpenAI).
# OpenCode Zen: AI_BASE_URL=https://opencode.ai/inference/openai/v1
# Ollama lokal : AI_BASE_URL=http://localhost:11434/v1
# JANGAN pakai model "*-free" untuk data warga asli (bisa dipakai melatih model).
AI_ENABLED=false
AI_DRIVER=fake
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_TIMEOUT=45
# Retensi catatan panggilan AI (tabel ai_calls, tanpa teks percakapan).
AI_LOG_RETENTION_DAYS=90
AI_SERVICE_DAYS=1,2,3,4,5
AI_SERVICE_START=08:00
AI_SERVICE_END=16:00
AI_SERVICE_LABEL="Senin–Jumat, 08.00–16.00 WIB"
