# Contact Center — stack subdomain uji. Buat .env (JANGAN di-commit, mode 600) dengan nilai acak baru:
#   bash scripts/deploy-uji.sh --env-baru      (atau salin manual lalu ganti semua GANTI)
# Hanya dibaca compose untuk interpolasi; tiap container menerima kunci yang ia butuhkan saja (compose.yml).
# Sandi & secret: `openssl rand -hex 32` (hanya huruf/angka — dipakai di URL & userlist PgBouncer, dicek
# scripts/deploy-uji.sh). Semua nilai KHUSUS uji: jangan pakai ulang kunci/sandi Laravel produksi.

# ---- Image (tag SHA, :uji-sehat & :uji-prev diatur scripts/deploy-uji.sh; nama wajib contact-center-uji —
# contact-center-web dicadangkan untuk produksi) ----
CC_IMAGE=contact-center-uji
CC_TAG=uji

# ---- PostgreSQL uji (service postgres; role dibuat uji/init.sh saat volume kosong) ----
# Mengganti sandi setelah volume terisi TIDAK mengubah role di DB: ALTER ROLE dulu, baru ubah di sini.
POSTGRES_PASSWORD=GANTI
CC_MIGRATE_PASSWORD=GANTI
CC_APP_PASSWORD=GANTI
CC_READONLY_PASSWORD=GANTI

# ---- Valkey (prefix kunci `cc:` di aplikasi) ----
VALKEY_PASSWORD=GANTI

# ---- Realtime (Sockudo, protokol Pusher). APP_KEY publik (dipakai browser); SECRET hanya server ----
REALTIME_APP_ID=contact-center-uji
REALTIME_APP_KEY=GANTI
REALTIME_APP_SECRET=GANTI

# ---- Aplikasi (dibaca web/src/server/env.ts dan paket F/G) ----
APP_URL=https://cc-uji.andimohamad.my.id
# APP_KEY & NIK_HASH_KEY baru khusus uji, masing-masing: echo "base64:$(openssl rand -base64 32)".
# DB uji tidak berisi data terenkripsi Laravel, jadi tidak perlu sama dengan kunci app2.
APP_KEY=GANTI
APP_PREVIOUS_KEYS=
NIK_HASH_KEY=GANTI
LOG_LEVEL=info
