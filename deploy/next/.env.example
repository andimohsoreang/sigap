# Contact Center (Next.js) — salin ke .env (JANGAN di-commit), chmod 600, lalu isi.
# File ini dipakai dua kali: interpolasi compose.yml dan env_file container web/worker.
# Nilai rahasia: hex acak (`openssl rand -hex 32`), tanpa `$` — compose menafsirkan `$`.

# Kredensial migrasi (cc_migrate) TIDAK di sini, tapi di .env.migrate (hanya service migrate).

# ---- Image & jaringan (compose) ----
CC_IMAGE=contact-center-web
CC_TAG=latest
# Jaringan milik stack Laravel (<project Laravel>_<nama>), lihat header compose.yml:
#   cc-edge  : nginx Laravel → cc-web:3000 (hanya nginx + cc-web)
#   internal : hanya pgbouncer, untuk menjangkau service `db`
LARAVEL_EDGE_NETWORK=app2-sigap_cc-edge
LARAVEL_NETWORK=app2-sigap_internal

# ---- Valkey (compose membentuk VALKEY_URL dari sini; prefix kunci `cc:` di aplikasi) ----
VALKEY_PASSWORD=GANTI_hex_acak

# ---- PostgreSQL lewat PgBouncer (role terpisah, rencana §9.3) ----
# Sandi sama dengan role di PostgreSQL; verifier SCRAM-nya di pgbouncer/userlist.txt.
# `contact_center` = alias PgBouncer untuk database fisik `sigap`.
DATABASE_URL=postgres://cc_app:GANTI@pgbouncer:6432/contact_center
DATABASE_URL_READONLY=postgres://cc_readonly:GANTI@pgbouncer:6432/contact_center

# ---- Aplikasi ----
# Kunci di bawah dibaca web/src/server/env.ts (paket A/B S0); samakan nama bila env.ts berbeda.
# APP_KEY, APP_PREVIOUS_KEYS, dan NIK_HASH_KEY HARUS sama dengan deploy/docker/.env (Laravel)
# selama transisi: sesi, cookie, data terenkripsi, dan hash NIK dibagi dua aplikasi.
APP_URL=https://app2.andimohamad.my.id
APP_KEY=base64:GANTI_sama_dengan_Laravel
APP_PREVIOUS_KEYS=
NIK_HASH_KEY=base64:GANTI_sama_dengan_Laravel
LOG_LEVEL=info
