# Env Sockudo 5.2.0 tanpa rahasia — SATU sumber untuk compose.yml (service sockudo, env_file) dan
# scripts/cek-binary-native.sh (docker run --env-file). Format KEY=VALUE polos: tanpa kutip, tanpa komentar di
# ujung baris (dibaca compose dan docker run). Kredensial app & origin diberikan terpisah oleh masing-masing.

# Mode `production` = nilai bawaan kode (ServerOptions::default), ditimpa env ENVIRONMENT atau `mode` di config.
# Di 5.2.0 mode ini hanya memengaruhi pagar driver memory fitur push (+ peringatan socket Unix di /tmp).
ENVIRONMENT=production

# Fitur push (notifikasi mobile/web) TIDAK bisa dimatikan lewat env: ia fitur kompilasi (`push`, ikut
# `full,monolith` di image resmi) dan penyimpanannya selalu dibuat saat start. Tanpa driver persisten
# (Postgres/MySQL/…), mode production menolak start kecuali driver memory diakui. Aman di sini: semua provider
# (PUSH_FCM/APNS/WEBPUSH/HMS/WNS_ENABLED) bawaan false, jadi publish push ditolak (tanpa provider aktif) dan
# store memory tetap kosong. Mematikan push sepenuhnya = build image sendiri tanpa fitur push (tidak dipakai).
PUSH_ALLOW_MEMORY_DRIVERS=true

# Antrean (webhook & push) tidak dipakai; bawaan kode = redis → WARN "Connection refused" tiap start.
QUEUE_DRIVER=none

# Driver lain eksplisit node-lokal (sama dengan bawaan 5.2.0, ditulis supaya perubahan bawaan versi baru
# tidak diam-diam menuntut Redis): satu instance, tanpa Valkey.
ADAPTER_DRIVER=local
APP_MANAGER_DRIVER=memory
CACHE_DRIVER=memory
RATE_LIMITER_DRIVER=memory

# client-* event tidak dipakai Laravel; Prometheus :9601 dimatikan sampai ada pengumpul (paket I); /usage mati.
SOCKUDO_DEFAULT_APP_ENABLE_CLIENT_MESSAGES=false
METRICS_ENABLED=false
HTTP_API_USAGE_ENABLED=false
