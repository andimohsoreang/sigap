# Kredensial migrasi — salin ke .env.migrate (JANGAN di-commit), chmod 600. Hanya dibaca service
# `migrate` (compose --profile migrate), tidak pernah oleh web/worker.
# `contact_center_migrate` = alias PgBouncer session pooling (DDL butuh state sesi & kunci advisory).
DATABASE_URL_MIGRATE=postgres://cc_migrate:GANTI@pgbouncer:6432/contact_center_migrate
LOG_LEVEL=info
