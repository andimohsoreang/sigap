# =============================================================================
# SIGAP — contoh konfigurasi lingkungan
# -----------------------------------------------------------------------------
# Nilai di bawah adalah default PENGEMBANGAN LOKAL. Blok "PRODUKSI" di akhir
# berkas berisi nilai yang wajib diganti di server (lihat docs/DEPLOY.md).
# PENTING: variabel VITE_* ditanam ke JavaScript saat `npm run build`, jadi
# .env harus sudah final SEBELUM build.
# =============================================================================

APP_NAME=SIGAP
APP_ENV=local
APP_KEY=
# Rotasi APP_KEY: pindahkan kunci lama ke sini (dipisah koma) agar data
# terenkripsi lama (mis. NIK) tetap terbaca.
APP_PREVIOUS_KEYS=
# Kunci blind index NIK (HMAC untuk login & keunikan NIK) — TERPISAH dari
# APP_KEY. Wajib di produksi/staging; lokal/testing jatuh ke APP_KEY bila kosong.
# JANGAN PERNAH diubah tanpa `php artisan sigap:rehash-nik`.
# Buat: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
NIK_HASH_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Proxy tepercaya (IP/CIDR dipisah koma). Kosong = tidak ada (lokal).
# Produksi: 127.0.0.1 — nginx sudah memulihkan IP asli dari CF-Connecting-IP.
# Jangan pernah '*'.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Database ---------------------------------------------------------------
# Lokal paling cepat: SQLite (database/database.sqlite).
DB_CONNECTION=sqlite
# Opsi lokal PostgreSQL 16 (sama dengan produksi):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sigap
# DB_USERNAME=sigap
# DB_PASSWORD=
# DB_SSLMODE=prefer          # DB di host lain: verify-full + DB_SSLROOTCERT
# DB_SSLROOTCERT=

# --- Sesi -------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kosong = otomatis true bila APP_ENV=production. Lokal (http) harus false.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum ----------------------------------------------------------------
# Domain yang boleh memakai sesi cookie untuk /api/v1 (per lingkungan!).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Masa berlaku token Bearer (menit). Default 7 hari; kosong/0/tidak valid = 10080
# (token tidak pernah abadi).
SANCTUM_EXPIRATION=10080

# --- Reverb (realtime) ------------------------------------------------------
# Dua sisi yang BERBEDA:
#   REVERB_*       → dipakai PHP untuk mempublikasikan event ke server Reverb.
#   VITE_REVERB_*  → dipakai BROWSER (ditanam saat build) & CSP connect-src.
# Lokal: keduanya localhost:8080 http (jalankan `php artisan reverb:start`).
# Kosongkan REVERB_APP_KEY untuk mematikan realtime (UI kembali ke polling).
# Buat key/secret acak: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
REVERB_APP_ID=sigap
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Alamat bind proses `reverb:start`. Produksi: 127.0.0.1 (di belakang nginx).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Host (tanpa skema) yang boleh membuka WebSocket. Default: host APP_URL.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_APP_MAX_CONNECTIONS=1000
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Google reCAPTCHA v3 (SEC-10) -------------------------------------------
# Kosongkan pada dev: formulir dikirim tanpa token & verifikasi dilewati.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Asisten AI contact center ---
# AI_ENABLED=false = live chat lama (langsung ke petugas).
# AI_DRIVER: fake (lokal/uji, tanpa kunci) | openai (endpoint kompatibel OpenAI).
# OpenCode Zen: AI_BASE_URL=https://opencode.ai/inference/openai/v1
# Ollama lokal : AI_BASE_URL=http://localhost:11434/v1
# JANGAN pakai model "*-free" untuk data warga asli (bisa dipakai melatih model).
AI_ENABLED=false
AI_DRIVER=fake
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_TIMEOUT=25
# Model penalaran (mis. deepseek-v4-flash di Sumopod: AI_BASE_URL=https://ai.sumopod.com/v1): isi "none".
AI_REASONING_EFFORT=
# Retensi catatan panggilan AI (tabel ai_calls, tanpa teks percakapan).
AI_LOG_RETENTION_DAYS=90
# Jawaban TARA lewat antrean `ai` (worker queue-ai). false = jalur sinkron lama (rollback cepat).
AI_ASYNC=true
AI_QUEUE=ai
# Ketahanan & biaya AI (PRD-AI FR-AI-03). 0 = tanpa batas token harian.
AI_DAILY_TOKEN_BUDGET=0
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN=300
AI_MAX_CALLS_PER_CONVERSATION_HOUR=20
# Model khusus per tugas (kosong = AI_MODEL).
AI_MODEL_SARAN_TIKET=
AI_MODEL_USUL_ARTIKEL=
AI_SERVICE_DAYS=1,2,3,4,5
AI_SERVICE_START=08:00
AI_SERVICE_END=16:00
AI_SERVICE_LABEL="Senin–Jumat, 08.00–16.00 WIB"
# Sumber Resmi yang dikutip asisten (domain + subdomain, pisahkan koma).
KNOWLEDGE_ALLOWED_HOSTS=transmigrasi.go.id,peraturan.bpk.go.id,peraturan.go.id

# =============================================================================
# PRODUKSI (app1.andimohamad.my.id) — salin ke .env server lalu isi rahasia.
# Staging (staging-app1.andimohamad.my.id): sama, ganti domain & APP_ENV=staging.
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://app1.andimohamad.my.id
# NIK_HASH_KEY=base64:<acak 32 byte — sama selamanya; ganti hanya dengan sigap:rehash-nik>
# TRUSTED_PROXIES=127.0.0.1
#
# LOG_STACK=daily
# LOG_LEVEL=warning
# LOG_DAILY_DAYS=14
#
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sigap
# DB_USERNAME=sigap
# DB_PASSWORD=<rahasia>
# DB_SSLMODE=prefer
#
# SESSION_DRIVER=database          # atau redis
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=null              # cookie host-only, tidak dibagi ke staging
# CACHE_STORE=database             # atau redis
# QUEUE_CONNECTION=database        # atau redis — WAJIB ada worker (supervisor)
# REDIS_PASSWORD=<rahasia, sama dengan requirepass>
#
# SANCTUM_STATEFUL_DOMAINS=app1.andimohamad.my.id
#
# BROADCAST_CONNECTION=reverb
# REVERB_APP_KEY=<acak>
# REVERB_APP_SECRET=<acak>
# REVERB_HOST=127.0.0.1            # PHP → Reverb lokal, tidak lewat internet
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_ALLOWED_ORIGINS=app1.andimohamad.my.id
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST=app1.andimohamad.my.id   # browser → nginx (wss) → Reverb
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
#
# RECAPTCHA_SITE_KEY=<site key v3>
# RECAPTCHA_SECRET_KEY=<secret key v3>
# =============================================================================
